# Plantilla pública de variables de entorno.
# Copia este archivo como `.env` y completa los valores reales:
#
#   cp .env.example .env
#
# `.env` está en .gitignore: nunca lo commitees, y nunca pongas aquí
# una URL real de backend ni una IP de despliegue.
# Ver .agents/rules/environment-variables.md

# URL base del backend de tasas (bcv_tracker_backend), SIN barra final.
# Los paths son absolutos (/api/v1/...), así que una barra final construiría
# //api/v1/... y el backend respondería un 308 en vez de servir el recurso.
CURRENCY_BACK=https://tu-backend.example.com
